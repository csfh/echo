/ std/io
/ std/str

$ a = [1, 2]
$ b = [1, 2]
$ c = a
io.print(str.from_int(a == b))
io.print(str.from_int(a === b))
io.print(str.from_int(a === c))
$ s1 = 'hi'
$ s2 = 'hi'
io.print(str.from_int(s1 == s2))
io.print(str.from_int(s1 === s2))
$ p = { x: 1, y: 2 }
$ q = { x: 1, y: 2 }
io.print(str.from_int(p == q))
io.print(str.from_int(p === q))
io.print(str.from_int(3 === 3))
io.print(str.from_int(3 !== 4))
