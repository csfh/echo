file
  import
    seg std
    seg io
  import
    seg std
    seg str
  bind_tilde
    name i
    number 0
  loop
    if
      binary Eq
        name i
        number 2
      break
    expr_stmt
      call
        field print
          name io
        call
          field from_int
            name str
          name i
    bind_tilde
      name i
      binary Add
        name i
        number 1
  expr_stmt
    call
