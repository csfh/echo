; Fixed argv vectors for std/cli (no process spawn).
/ std/io
/ std/str
/ std/list
/ std/cli

$ argv = ["tool", "--verbose", "--out", "a.txt", "in.echo"]
| cli.parse(argv) {
    $ t {
        ? cli.has(t, "verbose") {
            io.print("verbose")
        }
        | cli.get(t, "out") {
            $ v {
                io.print(v)
            }
            : {
                io.print("missing")
            }
        }
        $ pos = cli.positionals(t)
        io.print(str.from_int(list.len(pos)))
    }
    ! e {
        io.print(e)
    }
}
