file
  import
    seg std
    seg io
  import
    seg std
    seg str
  import
    seg std
    seg os
  import
    seg std
    seg path
  match
    call
      field cwd
        name os
    arm_ok here
      match
        call
          field chdir
            name os
          string_rich
        arm_ok ok
          match
            call
              field cwd
                name os
            arm_ok now
              expr_stmt
