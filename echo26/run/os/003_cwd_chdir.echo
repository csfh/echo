; chdir /tmp then restore; file name is tmp (or private/tmp on macOS).
/ std/io
/ std/str
/ std/os
/ std/path

| os.cwd() {
    $ here {
        | os.chdir("/tmp") {
            $ ok {
                | os.cwd() {
                    $ now {
                        io.print(path.file_name(now))
                    }
                    ! e {
                        io.print(e)
                    }
                }
                | os.chdir(here) {
                    $ ok2 {}
                    ! e {
                        io.print(e)
                    }
                }
            }
            ! e {
                io.print(e)
            }
        }
    }
    ! e {
        io.print(e)
    }
}
