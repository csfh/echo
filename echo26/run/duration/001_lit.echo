/ std/io
/ std/str

$ t = 5s
io.print(str.from_duration(t))
$ u = 10ms
io.print(str.from_duration(u))
$ v = 100us
io.print(str.from_duration(v))
$ w = 2m
io.print(str.from_duration(w))
$ x = 1h
io.print(str.from_duration(x))
$ sum = 5s + 10ms
io.print(str.from_duration(sum))
? sum == 5010ms {
    io.print('eq')
}
: {
    io.print('ne')
}
