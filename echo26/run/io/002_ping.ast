file
  import
    seg std
    seg io
  import
    seg std
    seg str
  match
    call
      field read
        name io
    arm_ok b
      expr_stmt
        call
          field print
            name io
          call
            field from_bytes
              name str
            name b
    arm_err e
      expr_stmt
        call
          field print
            name io
          name e
