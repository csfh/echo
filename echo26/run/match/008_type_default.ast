file
  import
    seg std
    seg io
  import
    seg std
    seg str
  struct circle
    bind_tilde
      name r
  struct rect
    bind_tilde
      name w
  bind_dollar
    name shape
    struct_lit rect
      field w
        number 4
  match
    name shape
    arm_type circle
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            number 1
    arm_default
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            number 2
