file
  import
    seg std
    seg io
  import
    seg std
    seg str
  struct circle
    bind_tilde
      name r
  struct rect
    bind_tilde
      name w
    bind_tilde
      name h
  bind_dollar
    name shape
    struct_lit circle
      field r
        number 3
  match
    name shape
    arm_type rect
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            number 0
    arm_type circle
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            field r
              name shape
    arm_default
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            number 9
