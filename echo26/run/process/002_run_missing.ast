file
  import
    seg std
    seg io
  import
    seg std
    seg process
  match
    call
      field run
        name process
      string_rich
      list
    arm_ok code
      expr_stmt
        call
          field print
            name io
          string_rich
    arm_err err
      expr_stmt
        call
          field print
            name io
          name err
