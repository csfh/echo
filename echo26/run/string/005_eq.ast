file
  import
    seg std
    seg io
  import
    seg std
    seg str
  if
    binary Eq
      string_pure
      string_rich
    expr_stmt
      call
        field print
          name io
        call
          field from_int
            name str
          number 1
  else
    expr_stmt
      call
        field print
          name io
        call
          field from_int
            name str
          number 0
