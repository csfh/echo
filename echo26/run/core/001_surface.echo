; Core surface through run: control, list, string, struct/method,
; result, option, widths, float, bytes. (Multi-file @ is run/multi/at_method.)
/ std/io
/ std/str

; --- control: if + while + break ---
~ n = 0
* n < 10 {
    ? n == 3 {
        <
    }
    ~ n = n + 1
}
io.print(str.from_int(n))

; --- list + index assign ---
$ xs = [1, 2, 3]
~ xs[1] = 9
io.print(str.from_int(xs[0]))
io.print(str.from_int(xs[1]))

; --- strings (pure / rich / eq; no +) ---
$ pure = 'core'
$ rich = "ok={pure}"
io.print(rich)
? pure == 'core' {
    io.print('eq')
}
: {
    io.print('ne')
}

; --- struct + method ---
% box {
    ~ v
    $ bump = () {
        ~ .v = .v + 1
        ^ .v
    }
}
$ b = box { v: 10 }
io.print(str.from_int(b.bump()))

; --- result ---
$ div = (a, d) {
    ? d == 0 {
        ! 0
    }
    ^ a / d
}
| div(20, 4) {
    $ q {
        io.print(str.from_int(q))
    }
    ! e {
        io.print(str.from_int(e))
    }
}

; --- option ---
$ maybe = (x) {
    ? x < 0 {
        ^
    }
    ^ x
}
| maybe(8) {
    $ v {
        io.print(str.from_int(v))
    }
    : {
        io.print(str.from_int(0))
    }
}

; --- widths i32 / f32 + default float ---
io.print(str.from_int(<i32> 10 + <i32> 20))
io.print(str.from_float(<f32> 1.5 + <f32> 2.25))
io.print(str.from_float(3.0 * 2.0))

; --- bytes ---
$ payload = b'raw'
io.print(str.from_bytes(payload))
