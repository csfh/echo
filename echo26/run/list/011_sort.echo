; Ascending integer insertion sort.
/ std/io
/ std/str
/ std/list

$ zs = list.sort_ints([3, 1, 2])
| list.get(zs, 0) {
    $ v {
        io.print(str.from_int(v))
    }
    ! e {
        io.print(e)
    }
}
| list.get(zs, 1) {
    $ v {
        io.print(str.from_int(v))
    }
    ! e {
        io.print(e)
    }
}
| list.get(zs, 2) {
    $ v {
        io.print(str.from_int(v))
    }
    ! e {
        io.print(e)
    }
}
