file
  import
    seg std
    seg io
  import
    seg std
    seg str
  bind_dollar
    name n
    number 40
  task_spawn
    bind job
    closure
      capture n
      return
        binary Add
          name n
          number 2
  task_join
    bind v
    handle
      name job
  expr_stmt
    call
      field print
        name io
      call
        field from_int
          name str
        name v
