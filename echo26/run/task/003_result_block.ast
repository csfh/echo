file
  import
    seg std
    seg io
  import
    seg std
    seg str
  task_join
    bind r
    block
      error_return
        number 3
  match
    name r
    arm_ok v
      expr_stmt
        call
          field print
            name io
          string_rich
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            name v
    arm_err e
      expr_stmt
        call
          field print
            name io
          string_rich
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            name e
