file
  import
    seg std
    seg io
  import
    seg std
    seg fs
  match
    call
      field chmod
        name fs
      string_rich
      number 420
    arm_ok ok
      expr_stmt
        call
          field print
            name io
          string_rich
    arm_err e
      expr_stmt
        call
          field print
            name io
          name e
