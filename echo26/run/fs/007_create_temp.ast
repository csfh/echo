file
  import
    seg std
    seg io
  import
    seg std
    seg str
  import
    seg std
    seg fs
  match
    call
      field create_temp
        name fs
      string_rich
    arm_ok p
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            call
              field exists
                name fs
              name p
      expr_stmt
        call
          field print
            name io
          call
            field from_int
              name str
            call
              field contains
                name str
              name p
              string_rich
      match
        call
          field remove
            name fs
          name p
        arm_ok ok
          expr_stmt
            call
              field print
                name io
              string_rich
        arm_err e
          expr_stmt
            call
              field print
                name io
              name e
    arm_err e
      expr_stmt
        call
          field print
            name io
          name e
