file
  import
    seg std
    seg io
  import
    seg std
    seg fs
  bind_dollar
    name p
    call
      field join
        name fs
      string_rich
      string_rich
  match
    call
      field write
        name fs
      name p
      string_rich
    arm_ok ok
      expr_stmt
        call
          field print
            name io
          string_rich
    arm_err e
      expr_stmt
        call
          field print
            name io
          name e
  match
    call
      field chmod
        name fs
      name p
      number 420
    arm_ok ok
      expr_stmt
        call
          field print
            name io
          string_rich
    arm_err e
      expr_stmt
        call
          field print
            name io
          name e
  match
    call
      field remove
        name fs
      name p
    arm_ok ok
      expr_stmt
        call
          field print
            name io
          string_rich
    arm_err e
      expr_stmt
        call
