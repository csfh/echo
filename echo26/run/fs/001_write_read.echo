; Write/read, metadata, stream, copy via std/fs.
/ std/io
/ std/str
/ std/bytes
/ std/fs

$ root = fs.join("/tmp", "echo26_fs_001")
| fs.create_dir_all(root) {
    $ ok {
        io.print("dir")
    }
    ! e {
        io.print(e)
    }
}
$ path = fs.join(root, "t.txt")
| fs.create(path) {
    $ f {
        | f.write("ok") {
            $ ok {
                io.print("write")
            }
            ! e {
                io.print(e)
            }
        }
        f.close()
    }
    ! e {
        io.print(e)
    }
}
| fs.metadata(path) {
    $ m {
        io.print(str.from_int(m.len))
    }
    ! e {
        io.print(e)
    }
}
$ copy = fs.join(root, "c.txt")
| fs.copy(path, copy) {
    $ ok {
        io.print("copy")
    }
    ! e {
        io.print(e)
    }
}
| fs.open(path) {
    $ f {
        | f.read(10) {
            $ b {
                io.print(str.from_bytes(b))
            }
            ! e {
                io.print(e)
            }
        }
        f.close()
    }
    ! e {
        io.print(e)
    }
}
| fs.remove(path) {
    $ ok {
        io.print("rm")
    }
    ! e {
        io.print(e)
    }
}
| fs.remove(copy) {
    $ ok {
        io.print("rm2")
    }
    ! e {
        io.print(e)
    }
}
| fs.remove_dir(root) {
    $ ok {
        io.print("rmdir")
    }
    ! e {
        io.print("rmdir-soft")
    }
}
