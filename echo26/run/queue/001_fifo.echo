; FIFO: push 1 then 2; pop yields 1 then 2.
/ std/io
/ std/str
/ std/collections/queue

~ q = queue.make()
q.push(1)
q.push(2)
io.print(str.from_int(q.len()))
| q.pop() {
    $ v {
        io.print(str.from_int(v))
    }
    ! e {
        io.print(e)
    }
}
| q.pop() {
    $ v {
        io.print(str.from_int(v))
    }
    ! e {
        io.print(e)
    }
}
io.print(str.from_int(q.is_empty()))
