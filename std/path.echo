; std/path — path helpers. Classification accepts string or locator.
; Pure Echo for parent/name/ext. Classification (class/is_abs/is_uri) is
; runtime.locator_class so locators and strings share one rule. Only `join`
; bridges OS path rules via fs.
/ runtime
/ std/test
/ std/str
/ std/list
/ std/fs

; Platform join (separator + absolute-rel rules) lives in runtime.fs_join.
$ join = (base, rel) {
    ^ runtime.fs_join(base, rel)
}

; Clean `.` / `..` segments (POSIX-ish).
$ clean = (p) {
    ^ runtime.path_clean(p)
}

; Relative path from base to target, or ! "rel failed".
$ rel = (base, target) {
    $ r = runtime.path_rel(base, target)
    ? r == 0 {
        ! "rel failed"
    }
    ^ r
}

; Shallow walk: list of paths for direct children of `root` (non-recursive).
; Full recursive Walk is deferred (function-order / HOF limits).
; Return is checker-`value` (match + list grow); callers use `list.is_empty` /
; `list.contains`, not i64 arithmetic on `list.len`.
$ walk = (root) {
    ~ out = []
    | fs.read_dir(root) {
        $ names {
            * name : names {
                ~ out[] = join(root, name)
            }
        }
        ! e {
            ^ out
        }
    }
    ^ out
}

; 0 relative · 1 absolute `/…` · 2 URI `scheme://…` (docs/semantics.md).
; Accepts a string or a locator handle.
$ class = (p) {
    ^ runtime.locator_class(p)
}

$ is_uri = (p) {
    ^ class(p) == 2
}

$ is_abs = (p) {
    ^ class(p) == 1
}

$ file_name = (p) {
    $ n = str.len(p)
    ~ i = n - 1
    ~ last = -1
    * i >= 0 {
        | str.get(p, i) {
            $ c {
                ? c == 47 {
                    ~ last = i
                    ~ i = -1
                }
                : {
                    ~ i = i - 1
                }
            }
            ! e {
                ~ i = -1
            }
        }
    }
    | str.slice(p, last + 1, n) {
        $ s {
            ^ s
        }
        ! e {
            ^ p
        }
    }
}

$ parent = (p) {
    $ n = str.len(p)
    ~ i = n - 1
    ~ last = -1
    * i >= 0 {
        | str.get(p, i) {
            $ c {
                ? c == 47 {
                    ~ last = i
                    ~ i = -1
                }
                : {
                    ~ i = i - 1
                }
            }
            ! e {
                ~ i = -1
            }
        }
    }
    ; No slash → `.`. Slash at index 0 is the root (`/foo` and `/` → `/`).
    ? last < 0 {
        ^ "."
    }
    ? last == 0 {
        ^ "/"
    }
    | str.slice(p, 0, last) {
        $ s {
            ^ s
        }
        ! e {
            ^ "."
        }
    }
}

$ extension = (p) {
    $ name = file_name(p)
    $ n = str.len(name)
    ~ i = n - 1
    ~ dot = -1
    * i >= 0 {
        | str.get(name, i) {
            $ c {
                ? c == 46 {
                    ~ dot = i
                    ~ i = -1
                }
                : {
                    ~ i = i - 1
                }
            }
            ! e {
                ~ i = -1
            }
        }
    }
    ? dot < 0 {
        ^ ""
    }
    | str.slice(name, dot + 1, n) {
        $ s {
            ^ s
        }
        ! e {
            ^ ""
        }
    }
}

test.it("class_abs_rel_uri", () {
    test.eq(class("/tmp"), 1)
    test.true(is_abs("/tmp"))
    test.false(is_uri("/tmp"))
    test.eq(class("home/user"), 0)
    test.false(is_abs("home/user"))
    test.eq(class("http://xo.run"), 2)
    test.true(is_uri("http://xo.run"))
    test.false(is_abs("http://xo.run"))
    test.eq(class(p'/home/user'), 1)
    test.eq(class(p"http://xo.run"), 2)
    test.false(is_uri("mailto:x"))
})

test.it("join_parent_name_ext", () {
    $ p = join("/tmp", "a.txt")
    test.true(str.contains(p, "a.txt"))
    test.eq(file_name(p), "a.txt")
    test.eq(extension(p), "txt")
    test.true(str.contains(parent(p), "tmp") || parent(p) == "/tmp")
})

test.it("parent_root_and_rel", () {
    test.eq(parent("/foo/bar"), "/foo")
    test.eq(parent("/foo"), "/")
    test.eq(parent("/"), "/")
    test.eq(parent("foo"), ".")
    test.eq(parent("foo/bar"), "foo")
})

test.it("clean_rel", () {
    test.eq(clean("/a/b/../c/./d"), "/a/c/d")
    | rel("/a/b", "/a/b/c") {
        $ r {
            test.eq(r, "c")
        }
        ! e {
            test.fail(e)
        }
    }
})

test.it("walk_missing", () {
    $ kids = walk("/tmp/echo_path_walk_missing_zzz")
    test.true(list.is_empty(kids))
})

test.it("walk_one_file", () {
    $ root = join(fs.temp_dir(), "echo_path_walk_suite")
    | fs.create_dir_all(root) {
        $ ok {}
        ! e {
            test.fail(e)
        }
    }
    $ f = join(root, "a.txt")
    | fs.write(f, "x") {
        $ ok {}
        ! e {
            test.fail(e)
        }
    }
    $ kids = walk(root)
    test.false(list.is_empty(kids))
    test.true(list.contains(kids, f))
    | fs.remove(f) {
        $ ok {}
        ! e {}
    }
    | fs.remove_dir(root) {
        $ ok {}
        ! e {}
    }
})

; Benchmarks: `xo test --bench std/path.echo`
test.bench("join", () {
    $ p = join("/usr/local", "bin/xo")
})

test.bench("clean", () {
    $ p = clean("/a/b/../c/./d/e/../f")
})

\ join, class, is_abs, is_uri, file_name, parent, extension, clean, rel, walk
