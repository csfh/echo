/ std/io
/ std/str

$ a = b'raw'
io.print(str.from_bytes(a))
$ b = b"esc\t!"
io.print(str.from_bytes(b))
$ n = 3
io.print(str.from_bytes(b"x={n}"))
? a == b'raw' {
    io.print(str.from_int(1))
}
: {
    io.print(str.from_int(0))
}
$ raw = b"\xffAB"
| str.slice(raw, 1, 3) {
    $ t {
        io.print(t)
    }
    ! e {
        io.print(e)
    }
}
