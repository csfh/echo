; Effect block (&): auto-unwrap result/option; short-circuit on fail
/ std/io
/ std/str
/ std/list

$ parse = (s) {
    ? str.len(s) == 0 {
        ! "empty"
    }
    ^ str.len(s)
}

; success path
& n = {
    $ a = list.get([10, 20, 30], 1)
    $ b = parse("hi")
    ^ a + b
}
io.print(str.from_int(n))

; fail path: bind gets err payload
& err = {
    $ a = list.get([10, 20], 9)
    ^ a
}
io.print(err)
