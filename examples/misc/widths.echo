/ std/io
/ std/str

; Full integer width family: i* / ui* ; byte ≡ ui8
io.print(str.from_int(<ui8> 200 + <ui8> 55))
io.print(str.from_int(<i8> -5 + <i8> 10))
io.print(str.from_int(<i16> 1000 + <i16> 24))
io.print(str.from_int(<ui32> 1 << <ui32> 8))
$ x = <ui8> 3
io.print(str.from_int(<ui64> x << <ui64> 8))
io.print(str.from_int(<byte> 1 | <ui8> 2))
io.print(str.from_int(<ui8> 16 >> <ui8> 1))
$ n = 3
io.print(str.from_float(<f64> n))
$ f = 3.9
io.print(str.from_int(<i32> f))
