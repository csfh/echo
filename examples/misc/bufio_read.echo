; bufio.read_lines. Run: xo run examples/misc/bufio_read.echo
/ std/io
/ std/str
/ std/list
/ std/fs
/ std/bufio

$ p = fs.join("/tmp", "echo_bufio_read_ex.txt")
| fs.write(p, "a\nb") {
    $ ok {}
    ! e {
        io.print(e)
    }
}
| bufio.read_lines(p) {
    $ ls {
        io.print(str.from_int(list.len(ls)))
        | list.get(ls, 1) {
            $ b {
                io.print(b)
            }
            ! e {
                io.print(e)
            }
        }
    }
    ! e {
        io.print(e)
    }
}
| fs.remove(p) {
    $ ok {}
    ! e {
        io.print(e)
    }
}
